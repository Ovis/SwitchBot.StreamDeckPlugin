{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Actions": [
    {
      "Name": "Bot",
      "Tooltip": "Control a SwitchBot Bot.",
      "UUID": "com.esheep.switchbot.bot",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key"
        }
      ],
      "PropertyInspectorPath": "ui/physical-control.html"
    },
    {
      "Name": "Power",
      "Tooltip": "Control a SwitchBot Plug or Plug Mini.",
      "UUID": "com.esheep.switchbot.power",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key"
        }
      ],
      "PropertyInspectorPath": "ui/physical-control.html"
    },
    {
      "Name": "Lighting",
      "Tooltip": "Control SwitchBot lights.",
      "UUID": "com.esheep.switchbot.lighting",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key"
        }
      ],
      "PropertyInspectorPath": "ui/physical-control.html"
    },
    {
      "Name": "Climate",
      "Tooltip": "Control SwitchBot climate devices.",
      "UUID": "com.esheep.switchbot.climate",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key"
        }
      ],
      "PropertyInspectorPath": "ui/physical-control.html"
    },
    {
      "Name": "Security",
      "Tooltip": "Control SwitchBot locks and security devices.",
      "UUID": "com.esheep.switchbot.security",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key"
        }
      ],
      "PropertyInspectorPath": "ui/physical-control.html"
    },
    {
      "Name": "Curtains & Blinds",
      "Tooltip": "Control SwitchBot curtains, blinds, and roller shades.",
      "UUID": "com.esheep.switchbot.curtains-blinds",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key"
        }
      ],
      "PropertyInspectorPath": "ui/physical-control.html"
    },
    {
      "Name": "Infrared Remote",
      "Tooltip": "Send commands to a SwitchBot virtual infrared remote.",
      "UUID": "com.esheep.switchbot.infrared-remote",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key"
        }
      ],
      "PropertyInspectorPath": "ui/infrared-remote.html"
    },
    {
      "Name": "Get Status",
      "Tooltip": "Get the selected SwitchBot device status.",
      "UUID": "com.esheep.switchbot.get-status",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key"
        }
      ],
      "PropertyInspectorPath": "ui/get-status.html",
      "UserTitleEnabled": false
    },
    {
      "Name": "API Request",
      "Tooltip": "Send a configured request to SwitchBot OpenAPI.",
      "UUID": "com.esheep.switchbot.api-request",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key"
        }
      ],
      "PropertyInspectorPath": "ui/api-request.html"
    }
  ],
  "Author": "Ovis",
  "CodePath": "bin/plugin.js",
  "Description": "Advanced Stream Deck client for SwitchBot OpenAPI v1.1.",
  "Icon": "imgs/plugin",
  "Name": "SwitchBot API Call",
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "UUID": "com.esheep.switchbot",
  "Version": "0.1.0.0",
  "URL": "https://github.com/Ovis/SwitchBot.StreamDeckPlugin",
  "SupportURL": "https://github.com/Ovis/SwitchBot.StreamDeckPlugin/issues",
  "Category": "SwitchBot API Call",
  "CategoryIcon": "imgs/action"
}
