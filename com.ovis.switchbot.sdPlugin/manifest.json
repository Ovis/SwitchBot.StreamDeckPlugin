{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Actions": [
    {
      "Name": "$Localization:Actions.GetDevices.Name",
      "Tooltip": "$Localization:Actions.GetDevices.Tooltip",
      "UUID": "com.ovis.switchbot.get-devices",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key"
        }
      ],
      "PropertyInspectorPath": "ui/get-devices.html"
    },
    {
      "Name": "$Localization:Actions.GetStatus.Name",
      "Tooltip": "$Localization:Actions.GetStatus.Tooltip",
      "UUID": "com.ovis.switchbot.get-status",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key"
        }
      ],
      "PropertyInspectorPath": "ui/get-status.html"
    },
    {
      "Name": "$Localization:Actions.ApiRequest.Name",
      "Tooltip": "$Localization:Actions.ApiRequest.Tooltip",
      "UUID": "com.ovis.switchbot.api-request",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key"
        }
      ],
      "PropertyInspectorPath": "ui/api-request.html"
    }
  ],
  "Author": "Ovis",
  "CodePath": "bin/plugin.js",
  "Description": "$Localization:Description",
  "Icon": "imgs/plugin",
  "Name": "$Localization:Name",
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "UUID": "com.ovis.switchbot",
  "Version": "0.1.0.0",
  "URL": "https://github.com/Ovis/SwitchBot.StreamDeckPlugin",
  "SupportURL": "https://github.com/Ovis/SwitchBot.StreamDeckPlugin/issues",
  "Category": "$Localization:Category",
  "CategoryIcon": "imgs/action",
  "LocalizationPath": "."
}
